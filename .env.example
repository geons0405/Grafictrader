# Grafictrader server environment (configure in Vercel → Settings → Environment Variables)

# FOTO AI and Market Mechanics AI (Gemini recommended; OpenAI is a fallback for FOTO)
GROQ_API_KEY=
NVIDIA_API_KEY=
AI_VISION_MODELS=
AI_JUDGE_MODELS=
UNOROUTER_API_KEY=
UNOROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# Paid credits (openrouter.ai): steady image reading when the free quotas run out. In its privacy settings, allow only providers that keep no data.
OPENROUTER_API_KEY=
# Optional: override the OpenAI model used by /api/analyze
OPENAI_MODEL=

# Optional intelligence providers
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
TWELVE_DATA_API_KEY=

# Binance market data is public and does not require a private key.

# Upstash Redis REST / Vercel KV. Enables:
#  - user accounts (scrypt-hashed passwords, HttpOnly session cookies)
#  - shared rate limiting for the AI endpoints
#  - the persistent Pattern Library
# Without it the app runs in "local mode": profiles stay on the device and
# the AI endpoints are protected only by per-instance rate limiting.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Owner-only detail on /api/health (send it as the x-admin-token header). At least 16 characters.
ADMIN_TOKEN=
# Daily AI analyses per account and for the whole app.
AI_DAILY_PER_USER=400
# Minutes of live analysis (Minha corretora, Android bubble) per day: free plan 10, paid plans no limit
LIVE_MINUTES_FREE=10
# Accounts treated as a paid plan (no live minute limit), comma-separated
PLAN_PRO_EMAILS=
# Error and usage reports (PostHog project key, public; build-time). Empty = off.
VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Web Push keys: optional, the server creates and stores its own when empty
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# LIVE_MINUTES_PAID=
AI_DAILY_GLOBAL=20000
# Turns on and protects the daily job /api/instructor?cron=1 (Vercel sends it automatically).
CRON_SECRET=
# Demo robot round-trip trading cost in percent.
INSTRUCTOR_COST_PCT=0.08
