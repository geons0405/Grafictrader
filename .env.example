# Grafictrader server environment (configure in Vercel → Settings → Environment Variables)

# FOTO AI and Market Mechanics AI (Gemini recommended; OpenAI is a fallback for FOTO)
UNOROUTER_API_KEY=
UNOROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# Optional: override the OpenAI model used by /api/analyze
OPENAI_MODEL=

# Optional intelligence providers
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
TWELVE_DATA_API_KEY=

# Binance market data is public and does not require a private key.

# Upstash Redis REST / Vercel KV. Enables:
#  - user accounts (scrypt-hashed passwords, HttpOnly session cookies)
#  - shared rate limiting for the AI endpoints
#  - the persistent Pattern Library
# Without it the app runs in "local mode": profiles stay on the device and
# the AI endpoints are protected only by per-instance rate limiting.
KV_REST_API_URL=
KV_REST_API_TOKEN=
